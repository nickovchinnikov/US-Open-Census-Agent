# Agno AgentOS AG-UI endpoint. This value is used only by the Next.js server.
# In the single-container Railway deployment, omit AGENT_URL: the default
# below reaches the bundled Python API through localhost.
AGENT_URL=http://127.0.0.1:7777/agui

# Disable CopilotKit's anonymous runtime telemetry for this self-hosted app.
COPILOTKIT_TELEMETRY_DISABLED=true
